<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
  <meta name="theme-color" content="#111827">
  <title>Scanner MULTI MODEM MDS</title>

  <script src="https://cdn.jsdelivr.net/npm/zxing-wasm/dist/iife/reader/index.js"></script>

  <style>
    :root{
      --bg:#eef1f4; --card:#fff; --text:#17202a; --muted:#69737d;
      --blue:#1565c0; --green:#11863b; --red:#b3261e; --amber:#8a6700;
      --border:#d5dbe1;
    }

    *{box-sizing:border-box}

    html,body{
      margin:0;
      min-height:100%;
      font-family:Arial,Helvetica,sans-serif;
      background:var(--bg);
      color:var(--text);
    }

    body{
      padding:max(8px,env(safe-area-inset-top)) 8px max(12px,env(safe-area-inset-bottom));
    }

    .app{max-width:760px;margin:0 auto}

    .topbar{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:8px;
      margin-bottom:8px;
    }

    h1{margin:0;font-size:21px}

    .counter{
      background:#111827;
      color:#fff;
      border-radius:999px;
      padding:7px 12px;
      font-weight:900;
      min-width:92px;
      text-align:center;
    }

    .card{
      background:var(--card);
      border-radius:12px;
      padding:10px;
      box-shadow:0 2px 8px rgba(0,0,0,.07);
      margin-bottom:8px;
    }

    .hero{
      font-size:13px;
      line-height:1.35;
      color:var(--muted);
      margin-bottom:8px;
    }

    #fileInput{display:none}

    button{
      border:0;
      border-radius:9px;
      min-height:46px;
      padding:8px;
      font-size:14px;
      font-weight:900;
      cursor:pointer;
    }

    button:disabled{opacity:.45;cursor:default}

    .primary{background:var(--blue);color:#fff}
    .secondary{background:#e4e7ea;color:#111}
    .danger{background:#f4dfdd;color:var(--red)}
    .copy{background:var(--green);color:#fff}

    .buttons{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:7px;
      margin-top:8px;
    }

    .full{grid-column:1 / -1}

    #previewWrap{
      display:none;
      margin-top:8px;
      background:#111;
      border-radius:10px;
      overflow:hidden;
      max-height:46vh;
    }

    #preview{
      display:block;
      width:100%;
      max-height:46vh;
      object-fit:contain;
    }

    canvas{display:none}

    .progressTrack{
      margin-top:8px;
      height:8px;
      background:#e5e7eb;
      border-radius:999px;
      overflow:hidden;
    }

    .progressBar{
      height:100%;
      width:0;
      background:var(--blue);
      transition:width .15s;
    }

    .status{
      margin-top:8px;
      min-height:42px;
      padding:9px 10px;
      border-radius:9px;
      background:#edf1f4;
      font-size:13px;
      font-weight:800;
      line-height:1.35;
    }

    .status.ok{background:#e6f5ea;color:#126b2f}
    .status.warn{background:#fff4d5;color:#755600}
    .status.err{background:#fde9e8;color:#9f1d16}

    .summary{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:8px;
    }

    .metric{
      background:#f5f6f7;
      border-radius:9px;
      padding:9px;
    }

    .metric .k{
      color:var(--muted);
      font-size:10px;
      font-weight:800;
    }

    .metric .v{
      margin-top:2px;
      font-size:24px;
      font-weight:900;
    }

    .list-head{
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin:9px 0 6px;
      font-size:14px;
    }

    #list{
      max-height:330px;
      overflow:auto;
      border:1px solid var(--border);
      border-radius:9px;
    }

    .row{
      display:grid;
      grid-template-columns:34px 1fr 68px 32px;
      gap:5px;
      align-items:center;
      padding:7px 6px;
      border-bottom:1px solid #edf0f2;
    }

    .row:last-child{border-bottom:0}

    .num{
      color:var(--muted);
      text-align:center;
      font-size:12px;
      font-weight:800;
    }

    .code{
      font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
      font-size:12px;
      font-weight:900;
      word-break:break-all;
    }

    .fmt{
      color:var(--muted);
      font-size:10px;
      text-align:right;
    }

    .del{
      min-height:30px;
      width:30px;
      padding:0;
      background:#f4dfdd;
      color:var(--red);
      font-size:17px;
    }

    .empty{
      padding:16px;
      text-align:center;
      color:var(--muted);
      font-size:13px;
    }

    .small{
      margin-top:7px;
      color:var(--muted);
      font-size:10px;
      line-height:1.35;
    }
  </style>
</head>

<body>
<div class="app">

  <div class="topbar">
    <h1>Scanner MULTI MODEM</h1>
    <div id="counter" class="counter">0/12</div>
  </div>

  <div class="card">
    <div class="hero">
      Fotografa l'etichetta con i seriali del collo. Il sistema cerca fino a 12 seriali MODEM,
      senza OCR, usando solo i barcode.
    </div>

    <button class="primary full" onclick="openCamera()">FOTOGRAFA BLOCCO DA 12</button>
    <input id="fileInput" type="file" accept="image/*" capture="environment" onchange="photoSelected(this)">

    <div id="previewWrap">
      <img id="preview">
    </div>

    <div class="buttons">
      <button id="btnAnalyze" class="primary" onclick="analyzePhoto()" disabled>ANALIZZA FOTO</button>
      <button class="secondary" onclick="addAnotherPhoto()">AGGIUNGI ALTRA FOTO</button>
    </div>

    <div class="progressTrack">
      <div id="progressBar" class="progressBar"></div>
    </div>

    <div id="status" class="status">Pronto. Fotografa un blocco di 12 seriali.</div>
  </div>

  <div class="card">
    <div class="summary">
      <div class="metric">
        <div class="k">SERIALI TROVATI</div>
        <div id="foundCount" class="v">0</div>
      </div>
      <div class="metric">
        <div class="k">TARGET BLOCCO</div>
        <div class="v">12</div>
      </div>
    </div>

    <div class="list-head">
      <strong>Seriali MODEM acquisiti</strong>
      <span id="resultState">0/12</span>
    </div>

    <div id="list">
      <div class="empty">Nessun seriale acquisito.</div>
    </div>

    <div class="buttons">
      <button class="danger" onclick="clearAll()">NUOVO BLOCCO</button>
      <button class="copy" onclick="copyAll()">COPIA 12 SERIALI</button>
    </div>

    <div class="small">
      Regola MODEM ricavata dalla lista reale: seriali che iniziano con "%" e hanno 21 o 22
      caratteri complessivi. Lettori: Code 39 Standard, Code 128 e Code 93.
      I duplicati vengono ignorati. Se una foto non arriva a 12/12, usa "AGGIUNGI ALTRA FOTO":
      i seriali già letti restano memorizzati.
    </div>
  </div>

</div>

<canvas id="workCanvas"></canvas>
<canvas id="tileCanvas"></canvas>

<script>
  const TARGET = 12;

  // Compatibilità verificata sui 2530 seriali MODEM forniti.
  const MODEM_REGEX = /^%[A-Z0-9]{20,21}$/;

  const fileInput = document.getElementById("fileInput");
  const preview = document.getElementById("preview");
  const previewWrap = document.getElementById("previewWrap");
  const workCanvas = document.getElementById("workCanvas");
  const tileCanvas = document.getElementById("tileCanvas");
  const workCtx = workCanvas.getContext("2d", { willReadFrequently: true });
  const tileCtx = tileCanvas.getContext("2d", { willReadFrequently: true });

  let currentImage = null;
  let currentObjectUrl = null;
  let accepted = new Map();
  let busy = false;
  let audioCtx = null;

  window.addEventListener("load", async () => {
    try {
      if (window.ZXingWASM?.prepareZXingModule) {
        await ZXingWASM.prepareZXingModule({ fireImmediately: true });
      }
    } catch (e) {
      console.warn("Preload ZXing non riuscito:", e);
    }
  });

  function normalizeCode(value) {
    let code = String(value || "")
      .trim()
      .toUpperCase()
      .replace(/^\*/, "")
      .replace(/\*$/, "")
      .replace(/\s+/g, "");

    // Compatibilità Code 39 Extended: alcuni decoder restituiscono "}" al posto di "%R".
    if (/^}[A-Z0-9]/.test(code)) {
      code = "%R" + code.slice(1);
    }

    return code;
  }

  function isValidModemSerial(code) {
    return MODEM_REGEX.test(code);
  }

  function openCamera() {
    if (busy) return;
    fileInput.value = "";
    fileInput.click();
  }

  function addAnotherPhoto() {
    if (busy) return;
    openCamera();
  }

  function photoSelected(input) {
    const file = input.files && input.files[0];
    if (!file) return;

    if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl);
    currentObjectUrl = URL.createObjectURL(file);

    const img = new Image();

    img.onload = () => {
      currentImage = img;
      preview.src = currentObjectUrl;
      previewWrap.style.display = "block";
      document.getElementById("btnAnalyze").disabled = false;
      setStatus(
        accepted.size
          ? `Nuova foto caricata. Già presenti ${accepted.size}/12 seriali. Premi ANALIZZA FOTO.`
          : "Foto caricata. Premi ANALIZZA FOTO."
      );
    };

    img.onerror = () => {
      setStatus("Impossibile caricare la foto.", "err");
    };

    img.src = currentObjectUrl;
  }

  async function analyzePhoto() {
    if (!currentImage || busy) return;

    if (!window.ZXingWASM?.readBarcodes) {
      setStatus("Motore barcode non caricato. Ricarica la pagina.", "err");
      return;
    }

    busy = true;
    document.getElementById("btnAnalyze").disabled = true;
    setProgress(1);

    try {
      const base = prepareBaseCanvas(currentImage);
      const regions = buildRegions(base.width, base.height);

      let done = 0;

      for (let i = 0; i < regions.length; i++) {
        if (accepted.size >= TARGET) break;

        const r = regions[i];
        const hardPass = i >= Math.floor(regions.length * 0.55);

        setStatus(
          `Analisi ${i + 1}/${regions.length} · trovati ${accepted.size}/12...`
        );

        await decodeRegion(base, r, hardPass);

        done = i + 1;
        setProgress(Math.round((done / regions.length) * 100));

        updateUI();
      }

      // Passata finale sull'immagine intera solo se serve.
      if (accepted.size < TARGET) {
        setStatus(`Passata finale · trovati ${accepted.size}/12...`);
        await decodeWholeImage(base);
        updateUI();
      }

      if (accepted.size >= TARGET) {
        // Non permettiamo più di 12 seriali nello stesso blocco.
        trimToTarget();
        updateUI();
        setProgress(100);
        setStatus("BLOCCO COMPLETO: 12/12 seriali MODEM.", "ok");
        beep(true);
      } else if (accepted.size > 0) {
        setStatus(
          `Lettura parziale: ${accepted.size}/12. Fai una seconda foto più vicina e premi AGGIUNGI ALTRA FOTO.`,
          "warn"
        );
      } else {
        setStatus(
          "Nessun seriale riconosciuto. Avvicina il telefono, tienilo parallelo e fotografa solo l'area dei barcode.",
          "err"
        );
      }

    } catch (err) {
      console.error(err);
      setStatus("Errore durante l'analisi: " + (err.message || err), "err");
    } finally {
      busy = false;
      document.getElementById("btnAnalyze").disabled = false;
    }
  }

  function prepareBaseCanvas(img) {
    /*
      Manteniamo molta più risoluzione del vecchio multi.
      Le foto da smartphone possono essere 3-4K: riduciamo solo se davvero necessario.
    */
    const maxSide = 3400;

    let w = img.naturalWidth || img.width;
    let h = img.naturalHeight || img.height;

    const scale = Math.min(1, maxSide / Math.max(w, h));

    w = Math.max(1, Math.round(w * scale));
    h = Math.max(1, Math.round(h * scale));

    workCanvas.width = w;
    workCanvas.height = h;

    workCtx.clearRect(0, 0, w, h);
    workCtx.drawImage(img, 0, 0, w, h);

    return workCanvas;
  }

  function buildRegions(W, H) {
    /*
      Analizziamo più geometrie perché le etichette MODEM reali non sono tutte uguali:
      - 1 colonna x 12 righe
      - 2 colonne x 6 righe
      - 3 colonne x 4 righe
      - etichette compatte / barcode sfalsati

      Ogni riquadro ha overlap per non tagliare il barcode ai bordi.
    */
    const regions = [];

    // Intera immagine: utile quando i barcode sono grandi.
    regions.push({ x: 0, y: 0, w: W, h: H, label: "FULL" });

    addGrid(regions, W, H, 1, 12, 0.98, 0.16, "1x12");
    addGrid(regions, W, H, 2, 6, 0.56, 0.27, "2x6");
    addGrid(regions, W, H, 3, 4, 0.40, 0.36, "3x4");

    // Fasce orizzontali sovrapposte: molto efficaci per barcode lunghi.
    const bands = 12;
    const bandH = Math.max(180, Math.round(H * 0.16));

    for (let i = 0; i < bands; i++) {
      const cy = (i + 0.5) * H / bands;
      const y = clamp(Math.round(cy - bandH / 2), 0, Math.max(0, H - bandH));
      regions.push({
        x: 0,
        y,
        w: W,
        h: Math.min(bandH, H),
        label: "BAND"
      });
    }

    return regions;
  }

  function addGrid(regions, W, H, cols, rows, widthFraction, heightFraction, label) {
    const tw = Math.min(W, Math.max(180, Math.round(W * widthFraction)));
    const th = Math.min(H, Math.max(150, Math.round(H * heightFraction)));

    for (let r = 0; r < rows; r++) {
      const cy = (r + 0.5) * H / rows;

      for (let c = 0; c < cols; c++) {
        const cx = (c + 0.5) * W / cols;

        const x = clamp(
          Math.round(cx - tw / 2),
          0,
          Math.max(0, W - tw)
        );

        const y = clamp(
          Math.round(cy - th / 2),
          0,
          Math.max(0, H - th)
        );

        regions.push({
          x,
          y,
          w: tw,
          h: th,
          label
        });
      }
    }
  }

  function clamp(v, min, max) {
    return Math.max(min, Math.min(max, v));
  }

  async function decodeRegion(base, r, hardPass) {
    if (r.w <= 0 || r.h <= 0) return;

    /*
      Portiamo ciascun tassello a una dimensione utile per ZXing.
      Non facciamo OCR né ricostruzioni del testo.
    */
    const maxTileW = 1700;
    const scale = Math.min(1, maxTileW / r.w);

    const dw = Math.max(1, Math.round(r.w * scale));
    const dh = Math.max(1, Math.round(r.h * scale));

    tileCanvas.width = dw;
    tileCanvas.height = dh;

    tileCtx.clearRect(0, 0, dw, dh);
    tileCtx.drawImage(
      base,
      r.x, r.y, r.w, r.h,
      0, 0, dw, dh
    );

    const imageData = tileCtx.getImageData(0, 0, dw, dh);

    const results = await ZXingWASM.readBarcodes(imageData, {
      formats: ["Code39Std", "Code128", "Code93"],
      tryHarder: hardPass,
      maxNumberOfSymbols: 6
    });

    processResults(results);
  }

  async function decodeWholeImage(base) {
    const imageData = workCtx.getImageData(0, 0, base.width, base.height);

    const results = await ZXingWASM.readBarcodes(imageData, {
      formats: ["Code39Std", "Code128", "Code93"],
      tryHarder: true,
      maxNumberOfSymbols: 24
    });

    processResults(results);
  }

  function processResults(results) {
    if (!Array.isArray(results)) return;

    for (const result of results) {
      if (accepted.size >= TARGET) break;

      const code = normalizeCode(result.text || "");
      if (!isValidModemSerial(code)) continue;
      if (accepted.has(code)) continue;

      accepted.set(code, {
        code,
        format: result.format || result.symbology || "BARCODE"
      });

      flashResult();
    }
  }

  function trimToTarget() {
    if (accepted.size <= TARGET) return;

    const first12 = [...accepted.entries()].slice(0, TARGET);
    accepted = new Map(first12);
  }

  function updateUI() {
    const arr = [...accepted.values()];
    const count = arr.length;

    document.getElementById("counter").textContent = `${count}/12`;
    document.getElementById("foundCount").textContent = count;
    document.getElementById("resultState").textContent = `${count}/12`;

    const list = document.getElementById("list");

    if (!count) {
      list.innerHTML = '<div class="empty">Nessun seriale acquisito.</div>';
      return;
    }

    list.innerHTML = arr.map((x, i) => `
      <div class="row">
        <div class="num">${i + 1}</div>
        <div class="code">${escapeHtml(x.code)}</div>
        <div class="fmt">${escapeHtml(x.format)}</div>
        <button class="del" onclick="removeAt(${i})" aria-label="Elimina">×</button>
      </div>
    `).join("");

    list.scrollTop = list.scrollHeight;
  }

  function removeAt(index) {
    const entries = [...accepted.entries()];
    if (index < 0 || index >= entries.length) return;

    const [key] = entries[index];
    accepted.delete(key);

    updateUI();
    setStatus(`Seriale rimosso. ${accepted.size}/12.`, "warn");
  }

  function clearAll() {
    accepted = new Map();

    if (currentObjectUrl) {
      URL.revokeObjectURL(currentObjectUrl);
      currentObjectUrl = null;
    }

    currentImage = null;
    preview.removeAttribute("src");
    previewWrap.style.display = "none";

    fileInput.value = "";
    setProgress(0);
    updateUI();

    setStatus("Nuovo blocco. Fotografa 12 seriali MODEM.");
  }

  async function copyAll() {
    const arr = [...accepted.keys()];

    if (!arr.length) {
      setStatus("Nessun seriale da copiare.", "warn");
      return;
    }

    const text = arr.join("\n");

    try {
      await navigator.clipboard.writeText(text);
    } catch (_) {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      document.execCommand("copy");
      ta.remove();
    }

    setStatus(
      accepted.size === TARGET
        ? "12 seriali copiati."
        : `${accepted.size} seriali copiati (blocco incompleto).`,
      accepted.size === TARGET ? "ok" : "warn"
    );

    beep(true);
  }

  function setProgress(value) {
    document.getElementById("progressBar").style.width =
      Math.max(0, Math.min(100, value)) + "%";
  }

  function setStatus(text, type = "") {
    const el = document.getElementById("status");
    el.className = "status" + (type ? " " + type : "");
    el.textContent = text;
  }

  function flashResult() {
    try {
      if (navigator.vibrate) navigator.vibrate(25);
    } catch (_) {}
  }

  function initAudio() {
    try {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === "suspended") audioCtx.resume();
    } catch (_) {}
  }

  function beep(ok = true) {
    try {
      initAudio();
      if (!audioCtx) return;

      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();

      osc.frequency.value = ok ? 1000 : 380;
      gain.gain.value = 0.06;

      osc.connect(gain);
      gain.connect(audioCtx.destination);

      osc.start();
      osc.stop(audioCtx.currentTime + 0.07);
    } catch (_) {}
  }

  function escapeHtml(value) {
    return String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  updateUI();
</script>

</body>
</html>
